---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import CTA from "../../components/CTA.astro";

const guides = (await getCollection("guides")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---
<Layout
  title="Pool Compliance Guides | Victoria"
  description="Plain-English guides to Victorian pool barrier compliance: Form 23, the four-year cycle, registration, selling and renting with a pool."
  path="/guides/"
>
  <Breadcrumbs items={[{ name: "Guides", path: "/guides/" }]} />

  <div class="mx-auto max-w-6xl px-4 py-10">
    <h1 class="text-3xl md:text-4xl font-extrabold text-navy-900 mb-4">Pool Compliance Guides</h1>
    <p class="text-lg text-navy-600 max-w-2xl mb-10">
      Plain-English guides to Victorian pool and spa barrier compliance — written for owners, vendors and landlords
      who want to understand the rules, not just tick a box.
    </p>

    <div class="grid sm:grid-cols-2 gap-6 mb-4">
      {guides.map((guide) => (
        <a href={`/guides/${guide.id}/`} class="block rounded-xl border border-navy-100 p-6 hover:border-accent-400 hover:shadow-md transition-all">
          <h2 class="text-lg font-bold text-navy-900 mb-2">{guide.data.title}</h2>
          <p class="text-navy-600 text-sm">{guide.data.metaDescription}</p>
        </a>
      ))}
    </div>

    <CTA />
  </div>
</Layout>
