---
import JsonLd from "./JsonLd.astro";
import ChevronDownIcon from "../icons/ChevronDownIcon.astro";
import { faqSchema, type FaqItem } from "../lib/schema";

export interface Props {
  faqs: FaqItem[];
  heading?: string;
}
const { faqs, heading = "Frequently asked questions" } = Astro.props;
const schema = faqSchema(faqs);
---
<JsonLd data={schema} />
<section class="my-12" aria-labelledby="faq-heading">
  <h2 id="faq-heading" class="text-2xl md:text-3xl font-bold text-navy-900 mb-6">{heading}</h2>
  <div class="space-y-3">
    {faqs.map((faq) => (
      <details class="group rounded-lg border border-navy-100 bg-white open:shadow-sm">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 font-semibold text-navy-900 marker:content-none">
          <span>{faq.question}</span>
          <ChevronDownIcon class="w-5 h-5 shrink-0 text-accent-600 transition-transform group-open:rotate-180" />
        </summary>
        <div class="px-5 pb-5 text-navy-700 leading-relaxed">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
