---
import PhoneIcon from "../icons/PhoneIcon.astro";
import { PHONE_NUMBER, PHONE_NUMBER_TEL, PRICE, GUARANTEE_SHORT } from "../config";

export interface Props {
  heading?: string;
  subtext?: string;
  quoteHref?: string;
}
const {
  heading = `Book a BPC-registered inspector — ${PRICE} flat`,
  subtext = `${GUARANTEE_SHORT}. Form 23 issued on the spot when it passes.`,
  quoteHref = "#quote-form",
} = Astro.props;
---
<section class="my-12 rounded-2xl bg-navy-900 px-6 py-10 md:px-12 md:py-12 text-center">
  <h2 class="text-2xl md:text-3xl font-bold text-white mb-3">{heading}</h2>
  <p class="text-navy-100 max-w-2xl mx-auto mb-7">{subtext}</p>
  <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
    <a
      href={`tel:${PHONE_NUMBER_TEL}`}
      class="inline-flex items-center gap-2 rounded-lg bg-accent-500 hover:bg-accent-600 text-white font-bold px-6 py-3.5 transition-colors w-full sm:w-auto justify-center"
    >
      <PhoneIcon class="w-5 h-5" />
      Call {PHONE_NUMBER}
    </a>
    <a
      href={quoteHref}
      class="inline-flex items-center gap-2 rounded-lg border-2 border-white/30 hover:border-white/60 text-white font-bold px-6 py-3.5 transition-colors w-full sm:w-auto justify-center"
    >
      Get a free quote
    </a>
  </div>
</section>
